{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "prime-local.schema.json",
  "title": "PrimeLocalClientData",
  "description": "Client business data collected during the /prime-local create interview (produces prime-local.json) and consumed by the composition step.",
  "type": "object",
  "additionalProperties": false,
  "required": ["nome", "segmento", "cidade", "whatsapp", "cores", "logoUrl"],
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do negócio."
    },
    "segmento": {
      "type": "string",
      "description": "Segmento/ramo de atuação do negócio."
    },
    "cidade": {
      "type": "string",
      "description": "Cidade onde o negócio está localizado."
    },
    "estado": {
      "type": "string",
      "description": "Estado (UF) onde o negócio está localizado."
    },
    "enderecoCompleto": {
      "type": "string",
      "description": "Endereço completo do negócio."
    },
    "bairrosERegioesAtendidas": {
      "type": "string",
      "description": "Bairros e/ou regiões atendidas pelo negócio."
    },
    "telefone": {
      "type": "string",
      "description": "Telefone de contato."
    },
    "whatsapp": {
      "type": "string",
      "description": "Número de WhatsApp para contato, usado nos CTAs do site."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "E-mail de contato do negócio, usado na seção Footer."
    },
    "mensagemPrincipalWhatsapp": {
      "type": "string",
      "description": "Mensagem pré-preenchida enviada ao clicar nos CTAs de WhatsApp."
    },
    "aboutText": {
      "type": "string",
      "description": "Texto institucional curto sobre o negócio, usado na seção Footer."
    },
    "horario": {
      "type": "string",
      "description": "Horário de funcionamento."
    },
    "instagram": {
      "type": "string",
      "description": "URL ou @ do perfil do Instagram."
    },
    "facebook": {
      "type": "string",
      "description": "URL da página do Facebook."
    },
    "googleBusinessProfile": {
      "type": "string",
      "description": "URL do perfil no Google Business Profile."
    },
    "googleMaps": {
      "type": "string",
      "description": "URL ou embed do Google Maps."
    },
    "title": {
      "type": "string",
      "description": "Title tag da página, para SEO."
    },
    "metaDescription": {
      "type": "string",
      "description": "Meta description da página, para SEO."
    },
    "palavraChavePrincipal": {
      "type": "string",
      "description": "Palavra-chave principal alvo de SEO."
    },
    "palavrasChaveSecundarias": {
      "type": "array",
      "description": "Palavras-chave secundárias alvo de SEO.",
      "items": { "type": "string" }
    },
    "produtos": {
      "type": "array",
      "description": "Produtos oferecidos pelo negócio.",
      "items": { "type": "string" }
    },
    "servicos": {
      "type": "array",
      "description": "Serviços oferecidos pelo negócio.",
      "items": { "type": "string" }
    },
    "diferenciaisConfirmados": {
      "type": "array",
      "description": "Diferenciais do negócio confirmados pelo cliente durante a entrevista.",
      "items": { "type": "string" }
    },
    "cores": {
      "type": "object",
      "description": "Paleta de marca do cliente. Sobrepõe os tokens de tema padrão do ui-kit (ver src/styles/tokens.css). Não inclui texto fixo sobre fundo claro/escuro — isso vem de --color-text-on-light/--color-text-on-dark, constantes do sistema (ver tokens.css), nunca deste objeto.",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
          "description": "Cor primária da marca, em hex."
        },
        "secondary": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
          "description": "Cor secundária da marca, em hex."
        },
        "text": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
          "description": "Cor de texto de apoio da marca, em hex. Opcional — não é mais um campo tipicamente fornecido pelo cliente; quando ausente, usa o fallback padrão de --color-text em tokens.css."
        },
        "accent": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
          "description": "Cor de destaque/CTA da marca, em hex. Opcional — quando ausente, usa o mesmo valor de 'primary' como fallback."
        },
        "colorSource": {
          "type": "string",
          "enum": ["logo", "manual"],
          "description": "Origem das cores acima: 'logo' quando extraídas automaticamente a partir de logoUrl, 'manual' quando fornecidas diretamente pelo cliente durante a entrevista."
        }
      }
    },
    "logoUrl": {
      "type": "string",
      "description": "URL do logo do cliente."
    },
    "imagens": {
      "type": "array",
      "description": "URLs das imagens recebidas do cliente para uso no site.",
      "items": { "type": "string" }
    },
    "sections": {
      "type": "object",
      "description": "Conteúdo já escrito de cada seção (briefing → UI Kit), mapeado 1:1 para o *Content de packages/ui-kit/src/sections/<Section>/types.ts. Cada entrada guarda SÓ o conteúdo próprio da seção: nome, whatsapp e mensagemPrincipalWhatsapp nunca vão aqui — a composição (create-flow.md, passo 5.4) os injeta a partir dos campos de topo. Header, LocationContact e Footer não têm entrada: são montados inteiramente a partir dos campos de topo. Uma seção fora da composição simplesmente não tem entrada.",
      "additionalProperties": false,
      "properties": {
        "Hero": { "$ref": "#/definitions/HeroSection" },
        "ProductsServices": { "$ref": "#/definitions/ProductsServicesSection" },
        "ConversionBanner": { "$ref": "#/definitions/ConversionBannerSection" },
        "Differentiators": { "$ref": "#/definitions/DifferentiatorsSection" },
        "HowItWorks": { "$ref": "#/definitions/HowItWorksSection" },
        "About": { "$ref": "#/definitions/AboutSection" },
        "FAQ": { "$ref": "#/definitions/FAQSection" },
        "SocialProof": { "$ref": "#/definitions/SocialProofSection" }
      }
    }
  },
  "definitions": {
    "ctaLabel": {
      "type": "string",
      "description": "Texto do botão de WhatsApp da seção. Opcional — o componente tem um rótulo padrão."
    },
    "imagePath": {
      "type": "string",
      "minLength": 1,
      "description": "Caminho público real de uma imagem recebida do cliente (ex: /images/servico-buffet.jpg). Omita o campo quando a imagem não existe — nunca string vazia nem arquivo gerado (content-rules.md)."
    },
    "HeroSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "backgroundImageUrl": { "$ref": "#/definitions/imagePath" },
        "highlights": {
          "type": "array",
          "description": "Só destaques reais do briefing — nunca completados até o máximo (content-rules.md).",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "text"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "ctaLabel": { "$ref": "#/definitions/ctaLabel" },
        "variant": { "enum": ["image-background"] }
      }
    },
    "ProductsServicesSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "heading": { "type": "string" },
        "subheading": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "subtitle"],
            "properties": {
              "imageUrl": { "$ref": "#/definitions/imagePath" },
              "title": { "type": "string", "minLength": 1 },
              "subtitle": { "type": "string", "minLength": 1 },
              "ctaLabel": { "$ref": "#/definitions/ctaLabel" }
            }
          }
        },
        "variant": { "enum": ["image-cards-grid"] }
      }
    },
    "ConversionBannerSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "body": { "type": "string" },
        "ctaLabel": { "$ref": "#/definitions/ctaLabel" },
        "variant": { "enum": ["solid-primary-banner"] }
      }
    },
    "DifferentiatorsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "heading": { "type": "string" },
        "subheading": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["icon", "title"],
            "properties": {
              "icon": {
                "enum": ["shield", "clock", "users", "award"],
                "description": "Chave do registro ICONS em Differentiators.tsx — um valor fora dele cairia silenciosamente no ícone padrão."
              },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string" }
            }
          }
        },
        "ctaLabel": { "$ref": "#/definitions/ctaLabel" },
        "variant": { "enum": ["icon-grid"] }
      }
    },
    "HowItWorksSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "heading": { "type": "string" },
        "subtitle": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stepNumber", "title", "description"],
            "properties": {
              "stepNumber": { "type": "integer", "minimum": 1 },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "ctaLabel": { "$ref": "#/definitions/ctaLabel" },
        "variant": { "enum": ["numbered-timeline"] }
      }
    },
    "AboutSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "subtitle"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "imageUrl": { "$ref": "#/definitions/imagePath" },
        "ctaLabel": { "$ref": "#/definitions/ctaLabel" },
        "variant": { "enum": ["text-image-split"] }
      }
    },
    "FAQSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions"],
      "properties": {
        "headline": { "type": "string" },
        "subtitle": { "type": "string" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "answer"],
            "properties": {
              "question": { "type": "string", "minLength": 1 },
              "answer": { "type": "string", "minLength": 1 }
            }
          }
        },
        "variant": { "enum": ["accordion"] }
      }
    },
    "SocialProofSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviews"],
      "properties": {
        "heading": { "type": "string" },
        "subheading": { "type": "string" },
        "ratingSummary": {
          "type": "object",
          "description": "Nota geral do perfil exatamente como o Google exibe — nunca calculada a partir de reviews. Omita quando o cliente não a forneceu.",
          "additionalProperties": false,
          "required": ["average"],
          "properties": {
            "average": { "type": "number", "minimum": 1, "maximum": 5 },
            "totalReviews": { "type": "integer", "minimum": 1 }
          }
        },
        "reviews": {
          "type": "array",
          "description": "Somente avaliações reais do Google fornecidas pelo cliente. Sem mínimo de 3: 1 ou 2 reais são publicadas como estão, nunca completadas (content-rules.md). Zero avaliações = seção fora da composição, sem entrada aqui.",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["authorName", "rating", "text"],
            "properties": {
              "authorName": { "type": "string", "minLength": 1 },
              "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
              "text": { "type": "string", "minLength": 1 },
              "relativeTime": { "type": "string" }
            }
          }
        },
        "ctaLabel": { "$ref": "#/definitions/ctaLabel" },
        "variant": { "enum": ["google-reviews-carousel"] }
      }
    }
  }
}
